    "typescript-language-server": {
      "plugins": [
        {
          "name": "@vue/typescript-plugin",
          "location": "~/.local/share/zed/extensions/work/vue/node_modules/@vue/language-server",
          "languages": ["vue.js"]
        }
      ]
    },
    "vue-language-server": {
      "initialization_options": {
        "vue": {
          "hybridMode": true
        }
      }
    }
  },
  "languages": {
    "Vue.js": {
      "tab_size": 2,
      "preferred_line_length": 120,
      "prettier": {
        "allowed": false
      }
      // "language_servers": ["typescript-language-server", "vue-language-server"]
    },
    "TypeScript": {
      "language_servers": ["typescript-language-server"],
      "tab_size": 2,
      "preferred_line_length": 120,
      "prettier": {
        "allowed": false
      }
    }
  }
}
